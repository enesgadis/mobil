{
  "expo": {
    "name": "DevPrimer",
    "slug": "devprimer-visionux",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.enes.devprimer",
      "adaptiveIcon": {
        "backgroundColor": "#070f1e"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bilgisayarlı görü ve jest takibi için kamera erişimi gereklidir."
        }
      ]
    ]
  }
}
